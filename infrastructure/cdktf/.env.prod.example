# Azure authentication for this environment
ARM_SUBSCRIPTION_ID=your-subscription-id
ARM_TENANT_ID=your-tenant-id
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=

# Infra identity for this environment
CDKTF_BASE_NAME=qrattendance
CDKTF_LOCATION=eastus2
CDKTF_RESOURCE_GROUP_NAME=rg-qr-attendance-prod
CDKTF_TAG_ENVIRONMENT=Production
CDKTF_TAG_APPLICATION=ProvePresent
CDKTF_TAG_MANAGED_BY=CDKTF
CDKTF_TAG_COST_CENTER=Engineering
CDKTF_TAG_DEPLOYMENT_METHOD=Hybrid
CDKTF_FRONTEND_URLS=
CDKTF_BLOB_CORS_ALLOWED_ORIGINS=https://*.azurestaticapps.net
CDKTF_DEPLOY_AZURE_OPENAI=true
CDKTF_DEPLOY_SIGNALR=true
CDKTF_GPT54_CAPACITY=2000
CDKTF_SIGNALR_SKU_NAME=Standard_S1
CDKTF_SIGNALR_SKU_CAPACITY=1

# App settings for this environment
CDKTF_JWT_SECRET=replace-with-a-secure-random-secret
CDKTF_OTP_SMTP_HOST=smtp.gmail.com
CDKTF_OTP_SMTP_PORT=465
CDKTF_OTP_SMTP_SECURE=true
CDKTF_OTP_SMTP_USERNAME=
CDKTF_OTP_SMTP_PASSWORD=
CDKTF_OTP_FROM_EMAIL=
CDKTF_OTP_FROM_NAME=ProvePresent
CDKTF_OTP_EMAIL_SUBJECT=Your ProvePresent Login verification code
CDKTF_OTP_APP_NAME=ProvePresent
CDKTF_ALLOWED_EMAIL_DOMAINS=
CDKTF_ORGANIZATION_NAME=
CDKTF_ORGANIZER_DOMAIN=vtc.edu.hk
CDKTF_ATTENDEE_DOMAIN=

# Optional features for this environment
CDKTF_ENABLE_FOUNDRY_TRACING_CONNECTION=true
CDKTF_ENABLE_STATIC_WEB_APP_BACKEND_LINK=true
# Exact existing Static Web App name. Required only when backend link is enabled.
# For existing apps, do not guess: Azure may append a random suffix.
CDKTF_STATIC_WEB_APP_NAME=swa-qrattendance-prod
CDKTF_STATIC_WEB_APP_LINKED_BACKEND_NAME=function-prod
